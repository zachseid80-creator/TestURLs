<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="BioStrip offers premium dissolvable peptide supplements for recovery, energy, metabolism, and cognitive support. Practitioner-grade oral strips with rapid absorption.">
  <meta name="keywords" content="peptide supplements, BPC-157, TB-500, NAD+, dissolvable strips, oral peptides, recovery supplements, energy supplements, metabolism support, cognitive enhancement">
  <meta property="og:title" content="BioStrip - Premium Peptide Supplements">
  <meta property="og:description" content="Practitioner-grade dissolvable peptide strips designed for rapid absorption. No injections. No mixing. Just dissolve and go.">
  <meta property="og:type" content="website">
  <title>BioStrip - Premium Dissolvable Peptide Supplements | BPC-157, NAD+, Metabolism</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-primary: #f8f9fc;
      --bg-card: #ffffff;
      --bg-card-hover: #f0f2f7;
      --text-primary: #1a1d29;
      --text-secondary: #5a5e72;
      --accent-cyan: #00b894;
      --accent-cyan-dim: #00a382;
      --accent-violet: #8b5cf6;
      --accent-peach: #fd9644;
      --accent-pink: #ec4899;
      --border-subtle: #e2e4eb;
      --shadow-soft: 0 4px 24px rgba(26, 29, 41, 0.08);
      --shadow-hover: 0 12px 40px rgba(26, 29, 41, 0.12);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      max-width: 100%;
      overflow-x: hidden;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background-color: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;
    }

    /* Subtle dot pattern */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: radial-gradient(circle, #d0d3dc 1px, transparent 1px);
      background-size: 32px 32px;
      pointer-events: none;
      z-index: -1;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* Navigation */
    nav {
      padding: 16px 0;
      position: sticky;
      top: 0;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-subtle);
      z-index: 100;
      box-shadow: 0 2px 20px rgba(0,0,0,0.04);
    }

    .nav-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-family: 'Instrument Serif', serif;
      font-size: 1.5rem;
      font-style: italic;
      color: var(--text-primary);
      text-decoration: none;
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .logo-icon {
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, var(--accent-cyan), var(--accent-violet));
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .logo-icon svg {
      width: 18px;
      height: 18px;
      stroke: #fff;
      fill: none;
    }

    .logo span {
      color: var(--accent-cyan);
    }

    .nav-links {
      display: flex;
      gap: 36px;
      list-style: none;
      align-items: center;
    }

    .nav-links a {
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      transition: color 0.3s ease;
      position: relative;
    }

    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--accent-cyan);
      transition: width 0.3s ease;
    }

    .nav-links a:hover {
      color: var(--text-primary);
    }

    .nav-links a:hover::after {
      width: 100%;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .nav-cta {
      background: var(--accent-cyan);
      color: #fff;
      padding: 12px 24px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9rem;
      transition: all 0.3s ease;
    }

    .nav-cta:hover {
      background: var(--accent-cyan-dim);
      transform: translateY(-2px);
      box-shadow: 0 4px 15px rgba(0, 184, 148, 0.3);
    }

    /* Hero Section */
    .hero {
      padding: 100px 0 80px;
      text-align: center;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(0, 184, 148, 0.1);
      border: 1px solid rgba(0, 184, 148, 0.25);
      padding: 8px 16px;
      border-radius: 100px;
      font-size: 0.8rem;
      color: var(--accent-cyan);
      margin-bottom: 32px;
      animation: fadeInUp 0.8s ease forwards;
      opacity: 0;
    }

    .hero-badge::before {
      content: '';
      width: 6px;
      height: 6px;
      background: var(--accent-cyan);
      border-radius: 50%;
      animation: pulse 2s ease-in-out infinite;
    }

    .hero h1 {
      font-family: 'Instrument Serif', serif;
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      font-weight: 400;
      line-height: 1.1;
      margin-bottom: 24px;
      animation: fadeInUp 0.8s ease 0.1s forwards;
      opacity: 0;
    }

    .hero h1 em {
      font-style: italic;
      color: var(--accent-cyan);
    }

    .hero p {
      font-size: 1.15rem;
      color: var(--text-secondary);
      max-width: 560px;
      margin: 0 auto 40px;
      animation: fadeInUp 0.8s ease 0.2s forwards;
      opacity: 0;
    }

    .hero-buttons {
      display: flex;
      gap: 16px;
      justify-content: center;
      animation: fadeInUp 0.8s ease 0.3s forwards;
      opacity: 0;
    }

    .btn-primary {
      background: var(--accent-cyan);
      color: #fff;
      padding: 14px 28px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
    }

    .btn-primary:hover {
      background: var(--accent-cyan-dim);
      box-shadow: 0 8px 24px rgba(0, 184, 148, 0.3);
    }

    .btn-secondary {
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-primary);
      padding: 14px 28px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 500;
      transition: all 0.3s ease;
    }

    .btn-secondary:hover {
      border-color: var(--text-secondary);
    }

    /* Products Section */
    .products {
      padding: 80px 0;
    }

    .section-header {
      text-align: center;
      margin-bottom: 60px;
    }

    .section-header h2 {
      font-family: 'Instrument Serif', serif;
      font-size: 2.5rem;
      font-weight: 400;
      margin-bottom: 12px;
    }

    .section-header p {
      color: var(--text-secondary);
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }

    .product-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 20px;
      padding: 24px;
      transition: all 0.4s ease;
      box-shadow: var(--shadow-soft);
      cursor: pointer;
    }

    .product-card:hover {
      background: var(--bg-card-hover);
      transform: translateY(-6px);
      box-shadow: var(--shadow-hover);
    }

    .product-tag {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 4px;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 16px;
    }

    .product-card:nth-child(1) .product-tag {
      background: rgba(139, 92, 246, 0.12);
      color: var(--accent-violet);
    }

    .product-card:nth-child(2) .product-tag {
      background: rgba(0, 184, 148, 0.12);
      color: var(--accent-cyan);
    }

    .product-card:nth-child(3) .product-tag {
      background: rgba(253, 150, 68, 0.12);
      color: var(--accent-peach);
    }

    .product-card:nth-child(4) .product-tag {
      background: rgba(236, 72, 153, 0.12);
      color: var(--accent-pink);
    }

    .product-image {
      width: 100%;
      height: 220px;
      border-radius: 14px;
      margin-bottom: 20px;
      overflow: hidden;
      position: relative;
      background: linear-gradient(135deg, #f0f2f7 0%, #e8eaf2 100%);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    .product-card:hover .product-image img {
      transform: scale(1.05);
    }

    .product-card h3 {
      font-size: 1.2rem;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .product-card .flavor {
      color: var(--text-secondary);
      font-size: 0.9rem;
      margin-bottom: 8px;
    }

    .product-card .card-desc {
      color: var(--text-secondary);
      font-size: 0.85rem;
      margin-bottom: 16px;
      line-height: 1.5;
    }

    .product-price {
      display: flex;
      align-items: baseline;
      gap: 12px;
      margin-bottom: 20px;
    }

    .product-price .current {
      font-size: 1.5rem;
      font-weight: 600;
      color: var(--accent-cyan);
    }

    .product-price .original {
      font-size: 1rem;
      color: var(--text-secondary);
      text-decoration: line-through;
    }

    .product-card .btn-primary {
      width: 100%;
      text-align: center;
    }

    /* Product Detail Modal */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(26, 29, 41, 0.6);
      backdrop-filter: blur(8px);
      z-index: 200;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
    }

    .modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .modal {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0.95);
      background: var(--bg-card);
      border-radius: 24px;
      width: 90%;
      max-width: 800px;
      max-height: 90vh;
      overflow-y: auto;
      z-index: 201;
      opacity: 0;
      visibility: hidden;
      transition: all 0.4s ease;
    }

    .modal.active {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, -50%) scale(1);
    }

    .modal-close {
      position: absolute;
      top: 20px;
      right: 20px;
      width: 40px;
      height: 40px;
      background: var(--bg-primary);
      border: 1px solid var(--border-subtle);
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
      z-index: 10;
    }

    .modal-close:hover {
      background: var(--border-subtle);
    }

    .modal-close svg {
      width: 20px;
      height: 20px;
      stroke: var(--text-primary);
    }

    .modal-content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      padding: 40px;
    }

    .modal-image {
      width: 100%;
      height: 400px;
      border-radius: 16px;
      overflow: hidden;
      background: linear-gradient(135deg, #f0f2f7 0%, #e8eaf2 100%);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-image img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 20px;
    }

    .modal-details h2 {
      font-family: 'Instrument Serif', serif;
      font-size: 2rem;
      font-weight: 400;
      margin-bottom: 8px;
    }

    .modal-details .flavor-tag {
      display: inline-block;
      color: var(--text-secondary);
      margin-bottom: 16px;
    }

    .modal-details .price {
      font-size: 2rem;
      font-weight: 600;
      color: var(--accent-cyan);
      margin-bottom: 24px;
    }

    .modal-details .description {
      color: var(--text-secondary);
      margin-bottom: 24px;
      line-height: 1.7;
    }

    .modal-details .features-list {
      list-style: none;
      margin-bottom: 32px;
    }

    .modal-details .features-list li {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      font-size: 0.95rem;
    }

    .modal-details .features-list li::before {
      content: '✓';
      color: var(--accent-cyan);
      font-weight: 600;
    }

    .modal-details .btn-primary {
      display: inline-block;
      width: auto;
      padding: 16px 40px;
    }

    .modal-details .disclaimer {
      font-size: 0.75rem;
      color: var(--text-secondary);
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px solid var(--border-subtle);
    }

    /* About Section */
    .about {
      padding: 100px 0;
      background: var(--bg-card);
      border-top: 1px solid var(--border-subtle);
      border-bottom: 1px solid var(--border-subtle);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .about-content h2 {
      font-family: 'Instrument Serif', serif;
      font-size: 2.25rem;
      font-weight: 400;
      margin-bottom: 20px;
    }

    .about-content p {
      color: var(--text-secondary);
      margin-bottom: 16px;
      line-height: 1.7;
    }

    .about-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .stat {
      text-align: center;
      padding: 24px 16px;
      background: var(--bg-primary);
      border-radius: 16px;
      border: 1px solid var(--border-subtle);
    }

    .stat-num {
      display: block;
      font-size: 2rem;
      font-weight: 600;
      color: var(--accent-cyan);
      margin-bottom: 4px;
    }

    .stat-label {
      font-size: 0.8rem;
      color: var(--text-secondary);
    }

    /* Features Section */
    .features {
      padding: 80px 0;
      border-top: 1px solid var(--border-subtle);
      background: var(--bg-card);
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 40px;
    }

    .feature {
      text-align: center;
    }

    .feature-icon {
      width: 56px;
      height: 56px;
      background: rgba(0, 184, 148, 0.1);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
    }

    .feature-icon svg {
      width: 24px;
      height: 24px;
      stroke: var(--accent-cyan);
    }

    .feature h3 {
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .feature p {
      color: var(--text-secondary);
      font-size: 0.9rem;
    }

    /* Newsletter */
    .newsletter {
    .newsletter {
      padding: 80px 0;
      text-align: center;
    }

    .newsletter h2 {
      font-family: 'Instrument Serif', serif;
      font-size: 2rem;
      font-weight: 400;
      margin-bottom: 12px;
    }

    .newsletter p {
      color: var(--text-secondary);
      margin-bottom: 32px;
    }

    .newsletter-form {
      display: flex;
      gap: 12px;
      max-width: 440px;
      margin: 0 auto;
    }

    .newsletter-form input {
      flex: 1;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      padding: 14px 18px;
      border-radius: 8px;
      color: var(--text-primary);
      font-size: 1rem;
      outline: none;
      transition: border-color 0.3s ease;
    }

    .newsletter-form input:focus {
      border-color: var(--accent-cyan);
    }

    .newsletter-form input::placeholder {
      color: var(--text-secondary);
    }

    .newsletter-form button {
      background: var(--accent-cyan);
      color: #fff;
      border: none;
      padding: 14px 24px;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .newsletter-form button:hover {
      background: var(--accent-cyan-dim);
    }

    /* Footer */
    footer {
      padding: 40px 0;
      border-top: 1px solid var(--border-subtle);
      background: var(--bg-card);
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .footer-copy {
      color: var(--text-secondary);
      font-size: 0.85rem;
    }

    .footer-links {
      display: flex;
      gap: 24px;
    }

    .footer-links a {
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 0.85rem;
      transition: color 0.3s ease;
    }

    .footer-links a:hover {
      color: var(--text-primary);
    }

    /* Animations */
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    /* Responsive */
    @media (max-width: 768px) {
      .nav-links { display: none; }
      .hero { padding: 60px 0 40px; }
      .hero-buttons { flex-direction: column; }
      .modal-content { grid-template-columns: 1fr; }
      .modal-image { height: 250px; }
      .newsletter-form { flex-direction: column; }
      .footer-inner { flex-direction: column; gap: 20px; text-align: center; }
      .about-grid { grid-template-columns: 1fr; }
      .about-stats { grid-template-columns: repeat(3, 1fr); }
    }
  </style>
</head>
<body>
  <nav>
    <div class="container nav-inner">
      <a href="#" class="logo">
        <div class="logo-icon">
          <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
        </div>
        Bio<span>Strip</span>
      </a>
      <ul class="nav-links">
        <li><a href="#products">Products</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#science">Science</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
      <div class="nav-right">
        <a href="#products" class="nav-cta">Shop Now</a>
      </div>
    </div>
  </nav>

  <section class="hero">
    <div class="container">
      <div class="hero-badge">Next-Generation Peptide Delivery System</div>
      <h1>Supplements that <em>dissolve</em><br>the old way.</h1>
      <p>Discover practitioner-grade peptide supplements in revolutionary dissolvable oral strips. Experience rapid absorption, zero injections, and zero hassle. Trusted by athletes, biohackers, and health-conscious individuals nationwide.</p>
      <div class="hero-buttons">
        <a href="#products" class="btn-primary">Shop All Products</a>
        <a href="#about" class="btn-secondary">How It Works</a>
      </div>
    </div>
  </section>

  <section class="products" id="products">
    <div class="container">
      <div class="section-header">
        <h2>Our Formulations</h2>
        <p>Science-backed peptides. Practitioner-grade quality. The future of supplementation is here.</p>
      </div>
      <div class="products-grid">
        <!-- Product 1 -->
        <div class="product-card" data-product="1">
          <span class="product-tag">Recovery</span>
          <div class="product-image">
            <img src="https://cdn.shopify.com/s/files/1/0860/5538/7170/files/P180wolverinestrips.png?v=1771088921" alt="Tissue Repair Complex - BPC-157 TB-500 Peptide Strips">
          </div>
          <h3>Tissue Repair Complex</h3>
          <p class="flavor">Strawberry Watermelon • 30 Strips</p>
          <p class="card-desc">Dual-peptide formula with BPC-157 & TB-500 for tissue repair, joint health, and recovery support.</p>
          <div class="product-price">
            <span class="current">$179</span>
          </div>
          <a href="#" class="btn-primary">View Details</a>
        </div>

        <!-- Product 2 -->
        <div class="product-card" data-product="2">
          <span class="product-tag">Energy</span>
          <div class="product-image">
            <img src="https://cdn.shopify.com/s/files/1/0860/5538/7170/files/P180NAdStrips.png?v=1771089019" alt="Cellular NAD+ Support - Nicotinamide Riboside Strips">
          </div>
          <h3>Cellular NAD+ Support</h3>
          <p class="flavor">Cool Mint • 30 Strips</p>
          <p class="card-desc">Nicotinamide riboside (NR) to boost NAD+ levels, support cellular energy, and combat age-related decline.</p>
          <div class="product-price">
            <span class="current">$199</span>
          </div>
          <a href="#" class="btn-primary">View Details</a>
        </div>

        <!-- Product 3 -->
        <div class="product-card" data-product="3">
          <span class="product-tag">Metabolism</span>
          <div class="product-image">
            <img src="https://cdn.shopify.com/s/files/1/0860/5538/7170/files/P180Metalean.png?v=1771088958" alt="Metabolic Reset Formula - Weight Management Strips">
          </div>
          <h3>Metabolic Reset Formula</h3>
          <p class="flavor">Cool Mint • 4 Strips</p>
          <p class="card-desc">Advanced metabolic support to help manage cravings, boost fat oxidation, and break through plateaus.</p>
          <div class="product-price">
            <span class="current">$89</span>
          </div>
          <a href="#" class="btn-primary">View Details</a>
        </div>

        <!-- Product 4 -->
        <div class="product-card" data-product="4">
          <span class="product-tag">Cognitive</span>
          <div class="product-image">
            <img src="https://cdn.shopify.com/s/files/1/0860/5538/7170/files/ChatGPT_Image_Feb_12_2026_at_06_51_39_PM.png?v=1771088986" alt="Neural Clarity Blend - Nootropic Strips">
          </div>
          <h3>Neural Clarity Blend</h3>
          <p class="flavor">Mixed Berry • 30 Strips</p>
          <p class="card-desc">Cognitive support with neuroprotective compounds for enhanced focus, memory, and mental clarity.</p>
          <div class="product-price">
            <span class="current">$159</span>
          </div>
          <a href="#" class="btn-primary">View Details</a>
        </div>
      </div>
    </div>
  </section>

  <section class="about" id="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-content">
          <h2>The Science of Dissolvable Peptides</h2>
          <p>At BioStrip, we believe supplementation shouldn't require a medical degree or a pharmacy of supplies. That's why we've engineered a delivery system that puts practitioner-grade peptides directly into your hands—no prescriptions, no needles, no mixing.</p>
          <p>Our dissolvable oral strips utilize sublingual absorption to deliver peptides directly through the oral mucosa into your bloodstream. This method bypasses the digestive system for higher bioavailability than traditional oral supplements, while eliminating the pain and hassle of injections.</p>
          <p>Every strip is pre-dosed with exact amounts of clinically studied ingredients. No measuring. No guessing. Just peel, dissolve, and go.</p>
        </div>
        <div class="about-stats">
          <div class="stat">
            <span class="stat-num">99%</span>
            <span class="stat-label">Bioavailability</span>
          </div>
          <div class="stat">
            <span class="stat-num">30s</span>
            <span class="stat-label">Time to Dissolve</span>
          </div>
          <div class="stat">
            <span class="stat-num">0</span>
            <span class="stat-label">Needles Required</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <div class="features-grid">
        <div class="feature">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
            </svg>
          </div>
          <h3>Rapid Absorption</h3>
          <p>Oral mucosa delivery for faster bioavailability than traditional formats.</p>
        </div>
        <div class="feature">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <path d="M9 9h6v6H9z"/>
            </svg>
          </div>
          <h3>Pre-Dosed Precision</h3>
          <p>Each strip contains exact amounts. No measuring, no mess.</p>
        </div>
        <div class="feature">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3>Practitioner Grade</h3>
          <p>Formulated with clinically studied peptides at therapeutic doses.</p>
        </div>
        <div class="feature">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <h3>On-the-Go Use</h3>
          <p>No water needed. No refrigeration. Fits in your pocket.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="newsletter">
    <div class="container">
      <h2>Join the BioStrip Community</h2>
      <p>Get exclusive access to new formulations, early releases, and subscriber-only discounts. Plus, receive our free peptide supplementation guide.</p>
      <form class="newsletter-form">
        <input type="email" placeholder="Enter your email address">
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </section>

  <footer>
    <div class="container footer-inner">
      <p class="footer-copy">© 2026 BioStrip. All rights reserved.</p>
      <div class="footer-links">
        <a href="#">Privacy</a>
        <a href="#">Terms</a>
        <a href="#">Shipping</a>
        <a href="#">Contact</a>
      </div>
    </div>
  </footer>

  <!-- Product Detail Modal -->
  <div class="modal-overlay" id="modalOverlay"></div>
  <div class="modal" id="productModal">
    <button class="modal-close" id="modalClose">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
    <div class="modal-content">
      <div class="modal-image">
        <img id="modalImg" src="" alt="">
      </div>
      <div class="modal-details">
        <span class="product-tag" id="modalTag"></span>
        <h2 id="modalTitle"></h2>
        <p class="flavor-tag" id="modalFlavor"></p>
        <p class="price" id="modalPrice"></p>
        <p class="description" id="modalDesc"></p>
        <ul class="features-list" id="modalFeatures"></ul>
        <a href="#" class="btn-primary">Add to Cart</a>
        <p class="disclaimer">These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</p>
      </div>
    </div>
  </div>

  <script>
    const products = [
      {
        id: 1,
        tag: 'Recovery',
        title: 'Tissue Repair Complex',
        flavor: 'Strawberry Watermelon • 30 Strips',
        price: '$179',
        img: 'https://cdn.shopify.com/s/files/1/0860/5538/7170/files/P180wolverinestrips.png?v=1771088921',
        desc: 'Engineered for peak performance and rapid recovery, the Tissue Repair Complex combines two of the most researched healing peptides—BPC-157 and TB-500—in one convenient dissolvable strip. These oral strips deliver therapeutic amounts directly through your oral mucosa, bypassing the need for injections or reconstitution. Whether you\'re an athlete pushing limits or someone recovering from injury, this formula supports your body\'s natural regenerative processes so you can get back to doing what you love—faster.',
        features: [
          'Dual-Peptide Formula: BPC-157 (250mcg) + TB-500 (125mcg) per strip',
          'Fast-Dissolving Oral Strips for sublingual absorption',
          'Promotes Joint, Tendon & Ligament Recovery',
          'Supports Natural Wound Healing & Tissue Repair',
          'Great-Tasting Strawberry Watermelon Flavor',
          '30 Strips Per Pack – One month supply',
          'No Needles, No Mixing, No Refrigeration'
        ]
      },
      {
        id: 2,
        tag: 'Energy',
        title: 'Cellular NAD+ Support',
        flavor: 'Cool Mint • 30 Strips',
        price: '$199',
        img: 'https://cdn.shopify.com/s/files/1/0860/5538/7170/files/P180NAdStrips.png?v=1771089019',
        desc: 'Your cellular engine runs on NAD+. But after 30, this vital coenzyme declines by about 50%, leaving you feeling sluggish, foggy, and aged. NAD+ Recharge delivers a potent dose of nicotinamide riboside (NR) directly to your cells—supporting mitochondrial function, cognitive clarity, and sustainable energy without the jitters or crash of stimulants. Think of it as an oil change for your cellular machinery.',
        features: [
          'Nicotinamide Riboside (NR) – Bioavailable NAD+ precursor',
          'Fast-Dissolving Oral Strips for superior absorption',
          'Supports Cellular Energy & ATP Production',
          'Promotes Healthy Metabolism & Mitochondrial Function',
          'Refreshing Cool Mint Flavor',
          '30 Strips Per Pack – Daily cellular support',
          'Clean Energy Without Caffeine or Stimulants'
        ]
      },
      {
        id: 3,
        tag: 'Metabolism',
        title: 'Metabolic Reset Formula',
        flavor: 'Cool Mint • 4 Strips',
        price: '$89',
        img: 'https://cdn.shopify.com/s/files/1/0860/5538/7170/files/P180Metalean.png?v=1771088958',
        desc: 'Metabolic Reset Formula is designed for those who\'ve hit a plateau—or want to avoid one. This advanced blend supports healthy metabolism, curbs cravings, and promotes fat oxidation as part of a comprehensive diet and exercise plan. No starvation required. Just better metabolic signaling. Perfect for jumpstarting your weight management journey or breaking through stubborn plateaus.',
        features: [
          'Metabolic Support Blend with researched ingredients',
          'Fast-Acting Dissolvable Strip format',
          'Supports Healthy Metabolism & Fat Burning',
          'Helps Manage Cravings & Appetite',
          'Refreshing Cool Mint Flavor',
          '4 Strips Per Pack – Concentrated reset protocol',
          'No Pills, No Injections, No Compromise'
        ]
      },
      {
        id: 4,
        tag: 'Cognitive',
        title: 'Neural Clarity Blend',
        flavor: 'Mixed Berry • 30 Strips',
        price: '$159',
        img: 'https://cdn.shopify.com/s/files/1/0860/5538/7170/files/ChatGPT_Image_Feb_12_2026_at_06_51_39_PM.png?v=1771088986',
        desc: 'Think faster, focus longer, remember more. Neural Clarity Blend combines nootropic-supporting compounds in a delicious berry strip that dissolves in seconds. Perfect for demanding workdays, study sessions, or anyone seeking that mental edge. Support your brain\'s neurotransmitters, cerebral blood flow, and neuroprotection—all without the jittery side effects of commercial energy drinks.',
        features: [
          'Cognitive Support Formula with neuroprotective compounds',
          'Great-Tasting Mixed Berry Flavor',
          '30 Strips Per Pack – Daily mental performance support',
          'Fast-Dissolving Oral Delivery for rapid onset',
          'Supports Focus, Memory & Mental Clarity',
          'No Water Required – Use anywhere, anytime',
          'Practitioner-Grade Quality You Can Feel'
        ]
      }
    ];

    const modal = document.getElementById('productModal');
    const overlay = document.getElementById('modalOverlay');
    const closeBtn = document.getElementById('modalClose');

    function openModal(productId) {
      const product = products.find(p => p.id === productId);
      if (!product) return;

      document.getElementById('modalImg').src = product.img;
      document.getElementById('modalTag').textContent = product.tag;
      document.getElementById('modalTitle').textContent = product.title;
      document.getElementById('modalFlavor').textContent = product.flavor;
      document.getElementById('modalPrice').textContent = product.price;
      document.getElementById('modalDesc').textContent = product.desc;
      
      const featuresList = document.getElementById('modalFeatures');
      featuresList.innerHTML = product.features.map(f => `<li>${f}</li>`).join('');

      overlay.classList.add('active');
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      overlay.classList.remove('active');
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.product-card').forEach(card => {
      card.addEventListener('click', (e) => {
        if (e.target.classList.contains('btn-primary')) return;
        const productId = parseInt(card.dataset.product);
        openModal(productId);
      });
    });

    document.querySelectorAll('.product-card .btn-primary').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const card = btn.closest('.product-card');
        const productId = parseInt(card.dataset.product);
        openModal(productId);
      });
    });

    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });

    // Smooth scroll
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // Nav scroll effect
    window.addEventListener('scroll', () => {
      const nav = document.querySelector('nav');
      if (window.scrollY > 50) {
        nav.style.background = 'rgba(255, 255, 255, 0.98)';
      } else {
        nav.style.background = 'rgba(255, 255, 255, 0.95)';
      }
    });
  </script>
</body>
</html>
